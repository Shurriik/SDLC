@startuml
title TrustRate — активность завершения сделки и публикации отзывов
start
:Участник открывает сделку;
:Проверить авторизацию, участие\nи статус In progress;
if (Проверка пройдена?) then (Да)
 :Участник подтверждает завершение;
 :Зафиксировать подтверждение;
 if (Проверка пройдена?) then (Да)
  :Установить статус Completed;
  :Обработать залог TC по правилам;
  :Открыть период отзывов;
  fork
   :Участник A отправляет отзыв;
   :Проверить оценку, право\nи отсутствие дубликата;
   :Сохранить отзыв;
  fork again
   :Участник B отправляет отзыв;
   :Проверить оценку, право\nи отсутствие дубликата;
   :Сохранить отзыв;
  end fork
  if (Условие публикации выполнено?) then (Да)
   :Опубликовать отзывы одновременно;
   :Выполнить антифрод-проверку;
   if (Есть подозрение?) then (Да)
    :Направить на модерацию;\nвременно исключить из рейтинга;
   else (Нет)
    :Пересчитать рейтинг;
   endif
  else (Нет)
   :Ожидать второй отзыв\nили окончания периода;
  endif
 else (Нет)
  :Оставить статус In progress;
 endif
else (Нет)
 :Отказать в операции и показать ошибку;
endif
stop
@enduml
